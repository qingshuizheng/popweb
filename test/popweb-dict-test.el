;;; popweb-dict-test.el --- Tests for popweb-dict  -*- lexical-binding: t; -*-

;;; Commentary:
;; The dictionary extension is mostly generated by `popweb-dict-create'; the
;; tests check that every site got its four commands, that the word around
;; point is used, and that the popup request carries the expected arguments.

;;; Code:

(require 'ert)

(require 'popweb-dict)

(setq popweb-start-python-process-when-require nil)

(defun popweb-dict-test--with-word (word function)
  "Call FUNCTION in a text buffer whose point is on WORD."
  (with-temp-buffer
    (insert "before " word " after")
    (goto-char (1+ (string-search word (buffer-string))))
    (funcall function)))

(ert-deftest popweb-dict-test-region-or-word-returns-the-word ()
  "Without a region the word at point is returned."
  (popweb-dict-test--with-word
   "translation"
   (lambda ()
     (should (equal (popweb-dict-region-or-word) "translation")))))

(ert-deftest popweb-dict-test-region-or-word-prefers-the-region ()
  "With an active region the region is returned, without properties."
  (with-temp-buffer
    (insert "one two three")
    (put-text-property 1 4 'face 'bold)
    (set-mark 1)
    (goto-char 4)
    (let ((mark-active t))
      (should (equal (popweb-dict-region-or-word) "one")))))

(ert-deftest popweb-dict-test-every-site-defines-its-commands ()
  "Each configured site has a pointer, an input and a hide function."
  (dolist (site '("bing" "youdao" "youglish" "dictcn"))
    (dolist (suffix '("pointer" "input" "translate" "web-window-can-hide"
                      "web-window-hide-after-move"))
      (should (fboundp (intern (format "popweb-dict-%s-%s" site suffix)))))))

(ert-deftest popweb-dict-test-prompt-input-uses-the-word-at-point ()
  "The prompt shows the word at point and offers it as the initial value."
  (let (captured)
    (cl-letf (((symbol-function 'read-string)
               (lambda (prompt &optional _initial _history default _inherit)
                 (setq captured (list prompt default))
                 "typed")))
      (popweb-dict-test--with-word
       "hello"
       (lambda ()
         (should (equal (popweb-dict-prompt-input "bing dict") "typed")))))
    (should (equal (nth 0 captured) "bing dict(hello): "))
    (should (equal (nth 1 captured) "hello"))))

(ert-deftest popweb-dict-test-size-defaults ()
  "The popup uses three tenths of the frame width and half its height."
  (should (= popweb-dict-web-window-width-scale 0.3))
  (should (= popweb-dict-web-window-height-scale 0.5)))

(ert-deftest popweb-dict-test-translate-sends-the-word-to-python ()
  "The request carries the site name, geometry, URL and JavaScript."
  (let ((popweb-dict-say-word-p nil)
        (popweb-dict-web-window-width-scale 0.6)
        (popweb-dict-web-window-height-scale 0.7)
        (popweb-dict-bing-web-window-visible-p nil)
        (calls nil))
    (cl-letf (((symbol-function 'popweb-get-cursor-coordinate)
               (lambda () '(10 . 20)))
              ((symbol-function 'window-inside-pixel-edges)
               (lambda (&optional _window) '(0 30 800 600)))
              ((symbol-function 'window-absolute-pixel-edges)
               (lambda (&optional _window) '(0 0 800 600)))
              ((symbol-function 'popweb-get-cursor-x-offset) (lambda () 0))
              ((symbol-function 'popweb-get-cursor-y-offset) (lambda () 17))
              ((symbol-function 'frame-position) (lambda (&optional _frame) '(5 . 6)))
              ((symbol-function 'frame-outer-width) (lambda (&optional _frame) 1000))
              ((symbol-function 'frame-outer-height) (lambda (&optional _frame) 800))
              ((symbol-function 'popweb-call-async)
               (lambda (method &rest args) (push (cons method args) calls)))
              ((symbol-function 'run-with-timer) (lambda (&rest _) nil)))
      (popweb-dict-bing-translate '("word")))
    (should (equal (caar calls) "call_module_method"))
    (let* ((args (cdar calls))
           (payload (nth 2 args)))
      (should (equal (nth 0 args) popweb-dict-module-path))
      (should (equal (nth 1 args) "pop_translate_window"))
      (should (equal (nth 0 payload) "dict_bing"))
      (should (equal (nth 1 payload) 10))
      (should (equal (nth 2 payload) -10))
      (should (equal (nth 9 payload) 0.6))
      (should (equal (nth 10 payload) 0.7))
      (should (equal (nth 11 payload)
                     "http://www.bing.com/dict/search?mkt=zh-cn&q=word"))
      (should (string-match-p "try {" (nth 12 payload)))
      (should (equal (nth 13 payload) "nil")))))

(ert-deftest popweb-dict-test-pointer-starts-the-popup-with-point ()
  "The pointer command passes the word at point to the callback."
  (let ((started nil)
        (popweb-dict-bing-web-window-visible-p nil))
    (cl-letf (((symbol-function 'popweb-start)
               (lambda (callback args) (setq started (list callback args))))
              ((symbol-function 'add-hook) (lambda (&rest _) nil)))
      (popweb-dict-test--with-word
       "word"
       (lambda () (call-interactively #'popweb-dict-bing-pointer))))
    (should (eq (nth 0 started) #'popweb-dict-bing-translate))
    (should (equal (nth 1 started) '("word")))))

(ert-deftest popweb-dict-test-input-reads-a-word ()
  "The input command reads a word and passes it, not the word at point."
  (let ((started nil)
        (popweb-dict-youdao-web-window-visible-p nil))
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "typed"))
              ((symbol-function 'popweb-start)
               (lambda (callback args) (setq started (list callback args))))
              ((symbol-function 'add-hook) (lambda (&rest _) nil)))
      (popweb-dict-youdao-input))
    (should (equal (cadr started) '("typed" nil)))))

(ert-deftest popweb-dict-test-hide-after-move-hides-and-stops-speaking ()
  "The popup is hidden, the word process killed and the hook removed."
  (let ((popweb-dict-bing-web-window-visible-p t)
        (popweb-dict-bing-say-word-process nil)
        (calls nil)
        (removed nil))
    (cl-letf (((symbol-function 'popweb-epc-live-p) (lambda (_manager) t))
              ((symbol-function 'popweb-call-async)
               (lambda (method &rest args) (push (cons method args) calls)))
              ((symbol-function 'remove-hook)
               (lambda (hook function) (setq removed (list hook function)))))
      (popweb-dict-bing-web-window-hide-after-move))
    (should (equal calls '(("hide_web_window" "dict_bing"))))
    (should-not popweb-dict-bing-web-window-visible-p)
    (should (equal removed '(post-command-hook popweb-dict-bing-web-window-hide-after-move)))))

(ert-deftest popweb-dict-test-can-hide-runs-on-a-timer ()
  "The popup becomes closable when the one second timer fires."
  (let ((delay nil)
        (popweb-dict-dictcn-web-window-visible-p nil))
    (cl-letf (((symbol-function 'run-with-timer)
               (lambda (seconds repeat function)
                 (setq delay (list seconds repeat))
                 (funcall function))))
      (popweb-dict-dictcn-web-window-can-hide))
    (should (equal delay '(1 nil)))
    (should popweb-dict-dictcn-web-window-visible-p)))

(provide 'popweb-dict-test)
;;; popweb-dict-test.el ends here
